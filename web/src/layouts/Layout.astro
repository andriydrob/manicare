---
import '../styles/global.css';
const { title = 'Manicare — салон краси' } = Astro.props;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Manicare: манікюр, педикюр, нарощування нігтів і вій, архітектура брів. Онлайн-запис." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@400;500;600&display=swap&subset=cyrillic" rel="stylesheet" />
  </head>
  <body><slot /></body>
</html>
